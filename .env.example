# Copy to .env (git-ignored). Never commit real keys.
MODE=mock                      # mock | live | recorded
AMD_API_KEY=
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_MODEL=Gemma-4-31B-IT
AMD_JSON_MODE=1
DATABASE_URL=sqlite:///nexus.db
ACCESS_TOKEN=                  # required when hosted
REQUEST_CAP=600
TOKEN_CAP=600000
AMD_SEND_MAX_TOKENS=0          # Gemma-4-31B-IT on Token Factory rejects max_tokens; use 1 for models that accept it
